{
  "name": "5m-maker",
  "version": "0.1.0",
  "description": "Market-maker validation harness + bot for Polymarket crypto 5-minute markets",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "npm run tsnode -- src/index.ts",
    "build": "tsc",
    "tsnode": "node --no-deprecation --import \"data:text/javascript,import { register } from 'node:module'; import { pathToFileURL } from 'node:url'; register('ts-node/esm', pathToFileURL('./'));\"",
    "test": "vitest",
    "test:run": "vitest run",
    "record": "npm run tsnode -- scripts/recorder.ts",
    "simulate": "npm run tsnode -- scripts/simulate.ts",
    "analyze": "npm run tsnode -- scripts/analyze.ts",
    "cancel-all": "npm run tsnode -- scripts/cancel-all.ts"
  },
  "dependencies": {
    "@ethersproject/wallet": "^5.8.0",
    "@polymarket/clob-client-v2": "^1.0.6",
    "@types/node-telegram-bot-api": "^0.64.14",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "js-yaml": "^4.1.0",
    "node-telegram-bot-api": "^0.66.0",
    "pino": "^8.17.0",
    "ws": "^8.15.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.8",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
